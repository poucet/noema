---
// Minimal layout for the Noema Tauri shell — no top nav, no container chrome.
// The NoemaApp Svelte component owns the entire viewport (activity bar +
// main view + settings modal).
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
}
const { title = 'Noema' } = Astro.props;
---
<html lang="en" class="bg-bg text-fg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="h-screen overflow-hidden font-sans antialiased">
    <slot />
  </body>
</html>
