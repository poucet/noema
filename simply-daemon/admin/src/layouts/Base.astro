---
import '../styles/global.css';

interface Props {
  title?: string;
  fullWidth?: boolean;
}
const { title = 'simply-daemon', fullWidth = false } = Astro.props;
---

<html lang="en" class="bg-bg text-fg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <nav class="border-b border-border px-4 py-2 flex items-center gap-6 text-sm">
      <a href="/" class="font-semibold text-white hover:no-underline">simply-daemon</a>
      <a href="/documents" class="text-muted hover:text-accent">Documents</a>
    </nav>
    <main class:list={[fullWidth ? '' : 'max-w-3xl mx-auto px-5 py-8']}>
      <slot />
    </main>
  </body>
</html>
