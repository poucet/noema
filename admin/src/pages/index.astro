---
import Base from '../layouts/Base.astro';
---

<Base title="simply-daemon">
  <div id="loading"><p>Loading...</p></div>

  <!-- ================================================================ -->
  <!-- SETUP WIZARD                                                     -->
  <!-- ================================================================ -->
  <div id="setup" class="hidden">
    <p>Let's get you set up. This takes about a minute.</p>

    <div class="steps">
      <span class="step-pill" data-step="1">1. Sign In</span>
      <span class="step-pill" data-step="2">2. API Keys</span>
      <span class="step-pill" data-step="3">3. Done</span>
    </div>

    <!-- Step 1: Google Sign-In -->
    <div id="step-1" class="card">
      <h2>Sign in with Google</h2>
      <p>The first person to sign in becomes the admin of this daemon.</p>

      <div id="google-ready" class="mt-2">
        <a href="/auth/login" class="btn btn-google">
          <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          Sign in with Google
        </a>
      </div>

      <div id="google-setup" class="hidden mt-2">
        <p>Google OAuth is not yet configured. Follow these steps:</p>
        <ol style="color:#999; font-size:0.84em; line-height:2; padding-left:20px; margin:10px 0">
          <li><a href="https://console.cloud.google.com/projectcreate" target="_blank">Create a Google Cloud project</a></li>
          <li><a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank">Configure OAuth consent screen</a> &mdash; External, app name: "Simply"</li>
          <li><a href="https://console.cloud.google.com/apis/credentials/oauthclient" target="_blank">Create OAuth 2.0 credentials</a> &mdash; Type: Web application</li>
          <li>Add authorized redirect URI: <code id="redirect-uri"></code></li>
          <li>Paste the credentials below:</li>
        </ol>
        <div class="form-row">
          <label>Client ID</label>
          <input type="text" id="g-client-id" placeholder="123456789.apps.googleusercontent.com" />
        </div>
        <div class="form-row">
          <label>Client Secret</label>
          <input type="password" id="g-client-secret" placeholder="GOCSPX-..." />
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" id="save-google-btn">Save &amp; Sign In</button>
        </div>
      </div>
    </div>

    <!-- Step 2: API Keys -->
    <div id="step-2" class="card hidden">
      <h2>Add API Keys</h2>
      <p>Add keys for the LLM providers you want to use. You can add more later from the dashboard.</p>
      <div class="provider-grid" id="setup-providers"></div>
      <div class="form-actions">
        <button class="btn btn-primary" id="step2-continue">Continue</button>
        <button class="btn btn-ghost" id="step2-skip">Skip for now</button>
      </div>
    </div>

    <!-- Step 3: Done -->
    <div id="step-3" class="card hidden">
      <h2 style="color:#14b8a6">You're all set!</h2>
      <p id="setup-summary"></p>
      <div class="form-actions">
        <button class="btn btn-primary" id="go-dashboard">Go to Dashboard</button>
      </div>
    </div>
  </div>

  <!-- ================================================================ -->
  <!-- DASHBOARD                                                        -->
  <!-- ================================================================ -->
  <div id="dashboard" class="hidden">
    <p id="admin-greeting" class="text-muted"></p>

    <h2>Connections <span class="badge badge-info" id="conn-count">0</span></h2>
    <table>
      <thead><tr><th>ID</th><th>Client</th><th>Address</th><th>Connected</th></tr></thead>
      <tbody id="conn-body"><tr><td colspan="4" class="empty">No connections</td></tr></tbody>
    </table>

    <h2>Sessions <span class="badge badge-info" id="sess-count">0</span></h2>
    <table>
      <thead><tr><th>ID</th><th>Model</th><th>Type</th><th>Created</th></tr></thead>
      <tbody id="sess-body"><tr><td colspan="4" class="empty">No active sessions</td></tr></tbody>
    </table>

    <h2>API Keys</h2>
    <div class="provider-grid" id="dash-providers"></div>

    <h2>Users</h2>
    <table>
      <thead><tr><th>ID</th><th>Email</th><th></th></tr></thead>
      <tbody id="user-body"><tr><td colspan="3" class="empty">No users</td></tr></tbody>
    </table>

    <h2>Settings</h2>
    <div class="card">
      <div class="form-row"><label>Admin</label><span id="d-admin" class="mono" style="color:#14b8a6">—</span></div>
      <div class="form-row"><label>Default Model</label><span id="d-model" class="mono">—</span></div>
    </div>

    <div class="mt-2">
      <button class="btn btn-danger" id="kill-btn">Shut Down Daemon</button>
      <span id="kill-status" class="text-muted" style="margin-left:10px;font-size:0.84em"></span>
    </div>
  </div>
</Base>

<script>
  import { api, PROVIDERS, type SetupStatus } from '../lib/api';

  let status: SetupStatus;

  // ==================== Boot ====================

  async function boot() {
    try {
      status = await api.getSetupStatus();
    } catch {
      document.getElementById('loading')!.innerHTML = '<p>Cannot reach daemon.</p>';
      return;
    }
    document.getElementById('loading')!.classList.add('hidden');

    if (status.is_configured) {
      showDashboard();
    } else {
      showSetup();
    }
  }

  // ==================== Setup Wizard ====================

  async function showSetup() {
    document.getElementById('setup')!.classList.remove('hidden');
    document.getElementById('redirect-uri')!.textContent = location.origin + '/auth/callback';

    const auth = await api.getAuthStatus();
    if (auth.google_oauth_available) {
      document.getElementById('google-ready')!.classList.remove('hidden');
      document.getElementById('google-setup')!.classList.add('hidden');
    } else {
      document.getElementById('google-ready')!.classList.add('hidden');
      document.getElementById('google-setup')!.classList.remove('hidden');
    }

    // If we're here after OAuth (admin_email now set), skip to step 2
    if (auth.is_setup_complete) {
      goStep(2);
    } else {
      goStep(1);
    }
  }

  function goStep(n: number) {
    for (let i = 1; i <= 3; i++) {
      document.getElementById(`step-${i}`)!.classList.toggle('hidden', i !== n);
      const pill = document.querySelector(`.step-pill[data-step="${i}"]`)!;
      pill.className = `step-pill ${i < n ? 'done' : i === n ? 'active' : ''}`;
    }
    if (n === 2) renderProviders('setup-providers');
    if (n === 3) renderSummary();
  }

  document.getElementById('save-google-btn')!.addEventListener('click', async () => {
    const id = (document.getElementById('g-client-id') as HTMLInputElement).value.trim();
    const secret = (document.getElementById('g-client-secret') as HTMLInputElement).value.trim();
    if (!id || !secret) { alert('Both fields are required.'); return; }
    await api.updateSettings({ google_client_id: id, google_client_secret: secret });
    location.href = '/auth/login';
  });

  document.getElementById('step2-continue')!.addEventListener('click', () => goStep(3));
  document.getElementById('step2-skip')!.addEventListener('click', () => goStep(3));
  document.getElementById('go-dashboard')!.addEventListener('click', () => location.reload());

  async function renderSummary() {
    status = await api.getSetupStatus();
    const keys = status.api_keys.length > 0 ? status.api_keys.join(', ') : 'none yet';
    document.getElementById('setup-summary')!.innerHTML =
      `Admin: <strong>${status.admin_email || '—'}</strong><br>` +
      `API keys configured: <strong>${keys}</strong><br>` +
      `<span class="text-muted">You can always add more from the dashboard.</span>`;
  }

  // ==================== Provider Grid ====================

  function renderProviders(containerId: string) {
    const el = document.getElementById(containerId)!;
    const configured = status?.api_keys || [];
    el.innerHTML = PROVIDERS.map(p => {
      const ok = configured.includes(p.id);
      return `<div class="provider-card ${ok ? 'configured' : ''}">
        <div class="provider-name">${p.name} ${ok ? '<span class="badge badge-ok">configured</span>' : ''}</div>
        <div class="provider-link"><a href="${p.url}" target="_blank">Get API key &rarr;</a></div>
        <div class="provider-input">
          <input type="password" data-provider="${p.id}" placeholder="${p.placeholder}" />
          <button class="btn btn-ghost save-key-btn" data-provider="${p.id}">Save</button>
          ${ok ? `<button class="btn btn-ghost rm-key-btn" data-provider="${p.id}" style="color:#ef4444;border-color:#ef4444">Remove</button>` : ''}
        </div>
      </div>`;
    }).join('');

    el.querySelectorAll('.save-key-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prov = (btn as HTMLElement).dataset.provider!;
        const input = el.querySelector(`input[data-provider="${prov}"]`) as HTMLInputElement;
        const key = input.value.trim();
        if (!key) return;
        await api.setApiKey(prov, key);
        input.value = '';
        status = await api.getSetupStatus();
        renderProviders(containerId);
      });
    });

    el.querySelectorAll('.rm-key-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prov = (btn as HTMLElement).dataset.provider!;
        await api.removeApiKey(prov);
        status = await api.getSetupStatus();
        renderProviders(containerId);
      });
    });
  }

  // ==================== Dashboard ====================

  async function showDashboard() {
    document.getElementById('dashboard')!.classList.remove('hidden');
    document.getElementById('admin-greeting')!.textContent = `Signed in as ${status.admin_email}`;
    renderProviders('dash-providers');
    refresh();
    setInterval(refresh, 5000);
  }

  async function refresh() {
    // Connections
    try {
      const conns = await api.getConnections();
      document.getElementById('conn-count')!.textContent = String(conns.length);
      document.getElementById('conn-body')!.innerHTML = conns.length === 0
        ? '<tr><td colspan="4" class="empty">No connections</td></tr>'
        : conns.map(c => `<tr><td>${c.id}</td><td>${c.name ?? '—'}</td><td class="mono">${c.addr}</td><td>${c.connected_at}</td></tr>`).join('');
    } catch {}

    // Sessions
    try {
      const sess = await api.getSessions();
      document.getElementById('sess-count')!.textContent = String(sess.length);
      document.getElementById('sess-body')!.innerHTML = sess.length === 0
        ? '<tr><td colspan="4" class="empty">No active sessions</td></tr>'
        : sess.map(s => `<tr><td class="mono">${s.id}</td><td>${s.model_id}</td><td>${s.persistence}</td><td>${s.created_at}</td></tr>`).join('');
    } catch {}

    // Users
    try {
      const users = await api.getUsers();
      document.getElementById('user-body')!.innerHTML = users.length === 0
        ? '<tr><td colspan="3" class="empty">No users</td></tr>'
        : users.map(u => `<tr><td class="mono" style="font-size:0.78em">${u.id}</td><td>${u.email}</td><td></td></tr>`).join('');
    } catch {}

    // Settings
    try {
      const s = await api.getSettings();
      document.getElementById('d-admin')!.textContent = s.admin_email || '—';
      document.getElementById('d-model')!.textContent = s.default_model || '(auto)';
    } catch {}
  }

  document.getElementById('kill-btn')!.addEventListener('click', async () => {
    if (!confirm('Shut down the daemon?')) return;
    await api.killDaemon();
    document.getElementById('kill-status')!.textContent = 'Shutdown signal sent.';
  });

  // Go
  boot();
</script>
