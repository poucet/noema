---
interface Props {
  title?: string;
}
const { title = 'simply-daemon' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>simply-daemon</h1>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, system-ui, 'Segoe UI', sans-serif;
    background: #0f0f1a;
    color: #e0e0e0;
    min-height: 100vh;
    line-height: 1.5;
  }
  .container { max-width: 760px; margin: 0 auto; padding: 40px 20px; }
  header h1 { font-size: 1.5em; color: #fff; margin-bottom: 4px; }

  h2 { font-size: 1.15em; color: #ccc; margin: 28px 0 10px; display: flex; align-items: center; gap: 8px; }
  h3 { font-size: 0.95em; color: #aaa; margin: 16px 0 6px; }
  p { color: #999; font-size: 0.9em; margin-bottom: 10px; }
  a { color: #14b8a6; text-decoration: none; }
  a:hover { text-decoration: underline; }
  code { background: #1e1e30; padding: 2px 6px; border-radius: 3px; font-size: 0.85em; color: #14b8a6; }

  /* Cards */
  .card {
    background: #16162a;
    border: 1px solid #252540;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 12px;
  }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 7px; border: none;
    cursor: pointer; font-size: 0.88em; font-weight: 500;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-primary { background: #14b8a6; color: #fff; }
  .btn-primary:hover { background: #0d9488; }
  .btn-danger { background: #dc2626; color: #fff; }
  .btn-danger:hover { background: #ef4444; }
  .btn-ghost { background: transparent; border: 1px solid #333; color: #aaa; }
  .btn-ghost:hover { border-color: #14b8a6; color: #14b8a6; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .btn-google {
    background: #fff; color: #333; font-size: 0.95em;
    padding: 12px 24px; border-radius: 8px; font-weight: 500;
  }
  .btn-google:hover { background: #f3f3f3; }

  /* Forms */
  input[type="text"], input[type="password"] {
    width: 100%; padding: 9px 12px;
    background: #0f0f1a; border: 1px solid #2a2a40; border-radius: 6px;
    color: #e0e0e0; font-size: 0.88em; font-family: monospace;
  }
  input:focus { outline: none; border-color: #14b8a6; }
  label { display: block; font-size: 0.82em; color: #777; margin-bottom: 3px; }
  .form-row { margin-bottom: 14px; }
  .form-actions { display: flex; gap: 8px; margin-top: 16px; }

  /* Badge */
  .badge {
    display: inline-block; padding: 2px 8px; border-radius: 4px;
    font-size: 0.72em; font-weight: 600; letter-spacing: 0.02em;
  }
  .badge-ok { background: #14b8a618; color: #14b8a6; }
  .badge-warn { background: #ef444418; color: #ef4444; }
  .badge-info { background: #3b82f618; color: #60a5fa; }

  /* Tables */
  table { width: 100%; border-collapse: collapse; margin: 6px 0 16px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #1e1e30; font-size: 0.84em; }
  th { color: #555; font-weight: 500; text-transform: uppercase; font-size: 0.72em; letter-spacing: 0.04em; }
  .empty { text-align: center; color: #3a3a50; font-style: italic; padding: 18px; }

  /* Steps */
  .steps { display: flex; gap: 6px; margin-bottom: 20px; }
  .step-pill {
    padding: 5px 14px; border-radius: 14px;
    font-size: 0.78em; font-weight: 500;
    background: #16162a; color: #555;
  }
  .step-pill.active { background: #14b8a6; color: #fff; }
  .step-pill.done { background: #14b8a618; color: #14b8a6; }

  /* Provider grid */
  .provider-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 640px) { .provider-grid { grid-template-columns: 1fr; } }
  .provider-card {
    background: #16162a; border: 1px solid #252540; border-radius: 8px; padding: 14px;
  }
  .provider-card.configured { border-color: #14b8a6; }
  .provider-name { font-weight: 600; font-size: 0.9em; margin-bottom: 2px; }
  .provider-link { font-size: 0.78em; margin-bottom: 8px; }
  .provider-input { display: flex; gap: 6px; }
  .provider-input input { flex: 1; font-size: 0.82em; padding: 7px 10px; }
  .provider-input .btn { padding: 7px 12px; font-size: 0.78em; }

  /* Utility */
  .mono { font-family: monospace; font-size: 0.82em; }
  .text-muted { color: #555; }
  .mt-1 { margin-top: 8px; }
  .mt-2 { margin-top: 16px; }
  .hidden { display: none !important; }
</style>
