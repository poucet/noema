#!/bin/bash
# lumina — run the Lumina Discord bot
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export RUST_LOG="${RUST_LOG:-lumina=debug,simply_daemon=info,simply_core=debug}"
export LUMINA_LOG_FILE="$REPO_ROOT/lumina.log"

# Start Lumina (auto-connects to existing daemon or starts embedded)
: > "$LUMINA_LOG_FILE"
echo "Starting lumina... (log: $LUMINA_LOG_FILE)"
cd "$REPO_ROOT" && cargo run -p lumina
