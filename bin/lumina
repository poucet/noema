#!/bin/bash
# lumina — run the Lumina Discord bot
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export RUST_LOG="${RUST_LOG:-lumina=debug,simply_daemon=info,simply_daemon::services::registry=debug,simply_daemon::services::tools=debug,simply_core=debug,llm::providers::gemini=debug,mcp_gdocs=debug,songbird=debug}"
export LUMINA_LOG_FILE="$REPO_ROOT/logs/lumina.log"

# Start Lumina (auto-connects to existing daemon or starts embedded)
mkdir -p "$(dirname "$LUMINA_LOG_FILE")"
: > "$LUMINA_LOG_FILE"
echo "Starting lumina... (log: $LUMINA_LOG_FILE)"
cd "$REPO_ROOT" && exec cargo run -p lumina
