#!/bin/bash
# lumina — run the Lumina Discord bot
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export RUST_LOG="${RUST_LOG:-lumina=debug,simply_daemon=info}"

case "${1:-run}" in
  run)
    # Start Lumina (expects daemon already running)
    export LUMINA_LOG_FILE="$REPO_ROOT/lumina.log"
    : > "$LUMINA_LOG_FILE"
    echo "Starting lumina... (log: $LUMINA_LOG_FILE)"
    cd "$REPO_ROOT" && cargo run -p lumina
    ;;
  split)
    # Start daemon in background, then Lumina
    "$SCRIPT_DIR/daemon" start

    cleanup() { "$SCRIPT_DIR/daemon" stop; }
    trap cleanup EXIT INT TERM

    export LUMINA_LOG_FILE="$REPO_ROOT/lumina.log"
    : > "$LUMINA_LOG_FILE"
    cd "$REPO_ROOT" && cargo run -p lumina
    ;;
  *)
    echo "Usage: lumina [run|split]"
    echo "  run    Start Lumina (daemon must be running) (default)"
    echo "  split  Start daemon + Lumina together"
    ;;
esac
