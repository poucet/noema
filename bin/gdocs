#!/bin/bash
# gdocs — start the Google Docs MCP server
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GDOCS_PORT="${GDOCS_PORT:-9877}"

export RUST_LOG="${RUST_LOG:-mcp_gdocs=debug}"
export GDOCS_LOG_FILE="$REPO_ROOT/logs/gdocs.log"


mkdir -p "$(dirname "$GDOCS_LOG_FILE")"
: > "$GDOCS_LOG_FILE"
echo "Starting Google Docs MCP server on port $GDOCS_PORT (log: $GDOCS_LOG_FILE)"
cd "$REPO_ROOT" && exec cargo run -p mcp-gdocs -- --port "$GDOCS_PORT"
