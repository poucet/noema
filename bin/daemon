#!/bin/bash
# daemon — manage the simply-daemon process
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DAEMON_PORT="${DAEMON_PORT:-9800}"

export RUST_LOG="${RUST_LOG:-simply_daemon=info,simply_daemon::net=info,simply_daemon::services=debug,simply_core=debug,simply_voice=debug}"
export DAEMON_LOG_FILE="${DAEMON_LOG_FILE:-$REPO_ROOT/logs/daemon.log}"
MLX_VOICE_PORT="${MLX_VOICE_PORT:-8100}"

log() { echo "[daemon] $*"; }

detect_voice_server() {
  if [ -n "$VOXTRAL_BASE_URL" ]; then return; fi
  if nc -z 127.0.0.1 "$MLX_VOICE_PORT" 2>/dev/null; then
    export VOXTRAL_BASE_URL="http://127.0.0.1:$MLX_VOICE_PORT"
    log "Detected local voice server on port $MLX_VOICE_PORT"
  fi
}

daemon_is_running() {
  nc -z 127.0.0.1 "$DAEMON_PORT" 2>/dev/null
}

build() {
  log "Building daemon (includes admin UI via build.rs)..."
  cd "$REPO_ROOT" && cargo build -p simply-daemon --bin simply-daemon
}

daemon_start() {
  local background="${1:-false}"

  if daemon_is_running; then
    log "Already running on port $DAEMON_PORT"
    log "Admin: http://127.0.0.1:$DAEMON_PORT"
    return 0
  fi

  build
  detect_voice_server
  mkdir -p "$(dirname "$DAEMON_LOG_FILE")"
  : > "$DAEMON_LOG_FILE"

  if [ "$background" = "true" ]; then
    log "Starting in background... (port: $DAEMON_PORT, log: $DAEMON_LOG_FILE)"
    cd "$REPO_ROOT" && cargo run -p simply-daemon --bin simply-daemon &
    local pid=$!

    log "Waiting for port $DAEMON_PORT (pid $pid)..."
    for i in $(seq 1 30); do
      if daemon_is_running; then
        log "Ready (pid $pid)"
        log "Admin: http://127.0.0.1:$DAEMON_PORT"
        return 0
      fi
      sleep 0.5
    done

    log "Failed to start (timeout)"
    kill "$pid" 2>/dev/null
    return 1
  else
    log "Starting... (port: $DAEMON_PORT, log: $DAEMON_LOG_FILE)"
    log "Admin: http://127.0.0.1:$DAEMON_PORT"
    cd "$REPO_ROOT" && cargo run -p simply-daemon --bin simply-daemon
  fi
}

daemon_stop() {
  if daemon_is_running; then
    log "Sending POST /daemon/kill..."
    curl -sf -X POST "http://127.0.0.1:$DAEMON_PORT/daemon/kill" >/dev/null 2>&1 || true

    for i in $(seq 1 10); do
      if ! daemon_is_running; then
        log "Stopped (clean shutdown)"
        return 0
      fi
      sleep 0.5
    done
    log "Still running after /daemon/kill"
  fi

  if daemon_is_running; then
    local port_pid
    port_pid=$(lsof -ti "tcp:$DAEMON_PORT" 2>/dev/null | head -1)
    if [ -n "$port_pid" ]; then
      log "Killing pid $port_pid (SIGTERM)..."
      kill "$port_pid" 2>/dev/null || true
      sleep 1
      if ! daemon_is_running; then
        log "Stopped (SIGTERM)"
        return 0
      fi
      kill -9 "$port_pid" 2>/dev/null || true
      log "Stopped (SIGKILL)"
      return 0
    fi
  fi

  log "Not running"
}

case "${1:-start}" in
  start)
    daemon_start false
    ;;
  start-bg)
    daemon_start true
    ;;
  stop|kill)
    daemon_stop
    ;;
  restart)
    daemon_stop
    sleep 1
    daemon_start false
    ;;
  status)
    if daemon_is_running; then
      port_pid=$(lsof -ti "tcp:$DAEMON_PORT" 2>/dev/null | head -1)
      log "Running on port $DAEMON_PORT (pid ${port_pid:-unknown})"
      log "Admin: http://127.0.0.1:$DAEMON_PORT"
    else
      log "Not running"
    fi
    ;;
  log|logs)
    tail -f "$DAEMON_LOG_FILE"
    ;;
  *)
    echo "Usage: daemon [start|start-bg|stop|restart|status|log]"
    echo "  start      Build and start daemon (foreground)"
    echo "  start-bg   Build and start daemon (background)"
    echo "  stop       Stop the daemon"
    echo "  restart    Stop + start (foreground)"
    echo "  status     Check if daemon is running"
    echo "  log        Tail the daemon log"
    ;;
esac
