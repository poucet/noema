# Optional. docker-compose reads this file if present; everything here has a
# sane default, so you usually don't need it at all.
#
# Per-server config (domain, Discord token, Google OAuth, API keys) is NOT set
# here — you pass the domain to ./start.sh and enter the rest in the browser
# setup wizard, which writes data/config/*.toml.

# Log filter for the lumina container.
RUST_LOG=info
