# 01-rest-api.hurl — Daemon REST API tests
# Covers TODO.md Section 1: Health, Models, Conversations, MCP, Assets


# ── Health & Info ─────────────────────────────────────────────

GET {{base}}/daemon
HTTP 200
[Asserts]
jsonpath "$.status" == "ok"

GET {{base}}/daemon/version
HTTP 200
[Asserts]
jsonpath "$" isString

GET {{base}}/model
HTTP 200
[Asserts]
jsonpath "$" isCollection

GET {{base}}/model/provider
HTTP 200
[Asserts]
jsonpath "$" isCollection

GET {{base}}/model/default
HTTP 200
[Asserts]
jsonpath "$" isString


# ── Conversations (CRUD lifecycle) ───────────────────────────

GET {{base}}/conversation
HTTP 200
[Asserts]
jsonpath "$" isCollection

# Create — single-param body is raw JSON, not {"name":"..."}
POST {{base}}/conversation
Content-Type: application/json
`"integration-test"`
HTTP 200
[Captures]
conv_id: jsonpath "$"
[Asserts]
jsonpath "$" isString

# List should contain the new conversation
GET {{base}}/conversation
HTTP 200
[Asserts]
jsonpath "$" count >= 1
jsonpath "$[*].id" contains "{{conv_id}}"

# Messages for new conversation (empty)
GET {{base}}/conversation/{{conv_id}}/messages
HTTP 200
[Asserts]
jsonpath "$" isCollection

# Delete
DELETE {{base}}/conversation/{{conv_id}}
HTTP 200
[Asserts]
jsonpath "$" == true

# Verify deletion
GET {{base}}/conversation
HTTP 200
[Asserts]
jsonpath "$[*].id" not contains "{{conv_id}}"


# ── MCP Servers ──────────────────────────────────────────────

GET {{base}}/mcp
HTTP 200
[Asserts]
jsonpath "$" isCollection

GET {{base}}/mcp/tools
HTTP 200
[Asserts]
jsonpath "$" isCollection


# ── Binary Assets ────────────────────────────────────────────

# Upload (test.bin is generated by the harness)
POST {{base}}/asset
Content-Type: application/octet-stream
file,test.bin;
HTTP 200
[Captures]
blob_hash: jsonpath "$.blob_hash"
asset_id: jsonpath "$.id"
[Asserts]
jsonpath "$.mime_type" == "application/octet-stream"
jsonpath "$.size_bytes" == 64

# List assets
GET {{base}}/asset
HTTP 200
[Asserts]
jsonpath "$" isCollection

# Get asset metadata
GET {{base}}/asset/{{asset_id}}
HTTP 200
[Asserts]
jsonpath "$.blob_hash" == "{{blob_hash}}"
jsonpath "$.mime_type" == "application/octet-stream"
jsonpath "$.size_bytes" == 64

# Download blob — verify cache headers and content size
GET {{base}}/blob/{{blob_hash}}
HTTP 200
[Asserts]
header "Cache-Control" == "public, max-age=31536000, immutable"
header "ETag" exists
bytes count == 64
